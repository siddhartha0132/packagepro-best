# Copy to .env for local runs; on Railway add these under Service → Variables.

# Core
JWT_SECRET=change-me-to-a-long-random-string
OAUTH_SERVER_URL=

# App database (trips + bookings). On Railway point this at the mounted volume.
# PACKAGEPRO_APP_DB=/data/packagepro-app.db

# AI + translation (Sarvam powers the chat, estimate insight and live translation)
SARVAM_API_KEY=
OPENROUTER_API_KEY=

# Flights (SerpAPI Google Flights is the primary live source)
SERP_API_KEY=
SKYSCANNER_API_KEY=
AVIANSTACK_API_KEY=

# Hotels / FX
HOTELBEDS_API_KEY=
HOTELBEDS_API_SECRET=
HOTELBEDS_API_KEY_ALT=
HOTELBEDS_API_SECRET_ALT=
EXCHANGE_RATE_API_KEY=

# Notifications on booking confirmation (optional)
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
