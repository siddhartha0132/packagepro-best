# PackagePro — every environment variable the app reads, with dummy or blank values.
# Copy to .env for local runs (`cp .env.example .env`); on Railway add them under Service → Variables.
# Optional keys are left BLANK on purpose: a blank key switches that provider off instantly (catalogue fares, rule-based text),
# while a fake key would make every call wait for a timeout. The comment above each shows the expected format.

# ---------------------------------------------------------------- server
PORT=3000
NODE_ENV=development
JWT_SECRET=dummy-change-me-to-a-long-random-string

# ---------------------------------------------------------------- data
# Read-only PS-04 dataset and its canonical DDL (defaults shown).
PACKAGEPRO_DB=data-model/seed/PS-04.db
PACKAGEPRO_SCHEMA=data-model/seed/schema.sqlite.sql
# Read-write app database: canonical trips / itineraries / itinerary_items / bookings + app_* additions.
# On Railway point this at the mounted volume, e.g. /data/packagepro-app.db
PACKAGEPRO_APP_DB=data/packagepro-app.db

# ---------------------------------------------------------------- AI + translation
# Sarvam: chat model (sarvam-105b-conversations) and mayura translation. OpenRouter is the fallback chat model.
# e.g. sk_xxxxxxxxxxxxxxxx
SARVAM_API_KEY=
# e.g. sk-or-v1-xxxxxxxx
OPENROUTER_API_KEY=

# ---------------------------------------------------------------- live travel data
# SerpAPI Google Flights is the primary live fare source; the others are fallbacks.
# e.g. 64-hex-character SerpAPI key
SERP_API_KEY=
SKYSCANNER_API_KEY=
AVIANSTACK_API_KEY=
HOTELBEDS_API_KEY=
HOTELBEDS_API_SECRET=
HOTELBEDS_API_KEY_ALT=
HOTELBEDS_API_SECRET_ALT=
EXCHANGE_RATE_API_KEY=

# ---------------------------------------------------------------- notifications on booking (optional)
# e.g. re_xxxxxxxx
RESEND_API_KEY=
# e.g. ACxxxxxxxx (account SID, not an SK API-key SID)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# e.g. +10000000000
TWILIO_FROM_NUMBER=

# ---------------------------------------------------------------- Telegram bot (optional)
# Long polling inside the server. Only one running instance may poll a token:
# set TELEGRAM_BOT_DISABLED=true locally once the deployed server runs the bot.
# e.g. 0000000000:AAxxxxxxxx from @BotFather — blank disables the bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_DISABLED=false
# Public https URL of the web app for "open on the web" links (Railway also provides RAILWAY_PUBLIC_DOMAIN).
# e.g. https://your-app.up.railway.app
PUBLIC_APP_URL=

# ---------------------------------------------------------------- template leftovers (unused by PackagePro; safe to leave blank)
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_APP_ID=
DATABASE_URL=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
